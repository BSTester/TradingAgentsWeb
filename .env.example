# ============================================
# TradingAgents 环境变量配置
# ============================================
# 复制此文件为 .env 并按需修改

# ============================================
# Docker 部署配置
# ============================================
# Nginx 反向代理后端地址（Docker 内部网络）
BACKEND_URL=backend:8000

# ============================================
# 数据库配置
# ============================================
# MySQL 数据库配置（推荐用于生产环境）
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=tradingagents
MYSQL_USER=tradingagents
MYSQL_PASSWORD=your_password

# 数据库连接 URL
# MySQL（异步驱动，代码会自动转换为同步用于后台任务）
DATABASE_URL=mysql+aiomysql://tradingagents:your_password@mysql:3306/tradingagents?charset=utf8mb4

# SQLite 本地文件数据库（开发环境）
# DATABASE_URL=sqlite+aiosqlite:///./db/tradingagents.db

# ============================================
# Next.js 配置
# ============================================
# 运行环境
NODE_ENV=production
SECRET_KEY=

# API 基础地址（开发环境使用）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================
# LLM API Keys（按需配置）
# ============================================
# OpenAI API Key
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEP_THINK_LLM=
QUICK_THINK_LLM=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_LLM=
EMBEDDING_API_KEY=

# ============================================
# 数据源 API Keys（可选）
# ============================================
# Alpha Vantage API Key
ALPHA_VANTAGE_API_KEY=

# XueQiu (雪球) Token
# 用于实时行情和基本面数据（A股/美股/港股）
# 获取方法：访问 https://xueqiu.com，登录后从浏览器 Cookie 中获取 xq_a_token
# 详见：docs/XUEQIU_TOKEN_SETUP.md
XUEQIU_TOKEN=

# ============================================
# Futu 模拟交易 API 配置
# ============================================
# Futu API 基础地址（内部服务地址）
# 默认：http://localhost:8000
FUTU_API_BASE_URL=http://localhost:8000

# Futu API Key（用于鉴权）
FUTU_API_KEY=

# API 请求超时时间（秒）
# 默认：30
FUTU_API_TIMEOUT=30

# ============================================
# 邮件通知配置（可选）
# ============================================
# SMTP 服务器配置
# 用于发送分析报告邮件通知
# 如果不配置，邮件功能将被禁用

# SMTP 服务器地址
# 示例：smtp.gmail.com, smtp.qq.com, smtp.163.com
SMTP_HOST=

# SMTP 服务器端口
# 常用端口：587 (TLS), 465 (SSL), 25 (不加密)
SMTP_PORT=587

# SMTP 用户名（通常是邮箱地址）
SMTP_USERNAME=

# SMTP 密码或应用专用密码
# Gmail: 需要使用应用专用密码 https://myaccount.google.com/apppasswords
# QQ邮箱: 需要开启SMTP服务并使用授权码
SMTP_PASSWORD=

# 发件人邮箱地址
# 通常与 SMTP_USERNAME 相同
SMTP_FROM_EMAIL=

# 是否使用 TLS 加密
# true: 使用 STARTTLS (端口 587)
# false: 使用 SSL (端口 465)
SMTP_USE_TLS=true

# 应用基础 URL
# 用于生成邮件中的链接
# 生产环境示例：https://tradingagents.com
# 开发环境示例：http://localhost:3000
APP_BASE_URL=http://localhost:3000