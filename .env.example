# ============================================
# TradingAgents 环境变量配置
# ============================================
# 复制此文件为 .env 并按需修改

# ============================================
# Docker 部署配置
# ============================================
# Nginx 反向代理后端地址（Docker 内部网络）
BACKEND_URL=backend:8000

# ============================================
# 数据库配置
# ============================================
# MySQL 数据库配置（推荐用于生产环境）
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=tradingagents
MYSQL_USER=tradingagents
MYSQL_PASSWORD=your_password

# 数据库连接 URL
# MySQL（异步驱动，代码会自动转换为同步用于后台任务）
DATABASE_URL=mysql+aiomysql://tradingagents:your_password@mysql:3306/tradingagents?charset=utf8mb4

# SQLite 本地文件数据库（开发环境）
# DATABASE_URL=sqlite+aiosqlite:///./db/tradingagents.db

# ============================================
# Next.js 配置
# ============================================
# 运行环境
NODE_ENV=production
SECRET_KEY=

# API 基础地址（开发环境使用）
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============================================
# LLM API Keys（按需配置）
# ============================================
# OpenAI API Key
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEEP_THINK_LLM=
QUICK_THINK_LLM=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_LLM=
EMBEDDING_API_KEY=

# ============================================
# 数据源 API Keys（可选）
# ============================================
# Alpha Vantage API Key
ALPHA_VANTAGE_API_KEY=
